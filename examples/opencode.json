{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "browser-harness": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Browser Harness",
      "options": {
        "baseURL": "http://127.0.0.1:4318/v1",
        "apiKey": "{env:BROWSER_HARNESS_API_KEY}"
      },
      "models": {
        "chatgpt-browser": {
          "name": "ChatGPT (browser)"
        }
      }
    }
  },
